# ColorFlow Web 环境变量模板
# 复制为 .env 后按需修改；docker run --env-file .env 或 docker compose --env-file .env

# ── 服务 ──────────────────────────────────────────────
PORT=5000
THREADS=4                       # waitress 工作线程数（CPU 密集型建议 2-8）
FLASK_DEBUG=false               # 生产务必 false

# ── API 鉴权 ──────────────────────────────────────────
# 设置后启用 /api/* 鉴权；首次启动可先不设，进设置页生成 Key 后再注入
# COLORFLOW_API_KEY=cfk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── GEN 生图后端（至少配一个，否则 /api/generate 返回 401）─
# VOLCANO_API_KEY=                  # 火山方舟 / 即梦 Seedream（国内默认）
# FAL_KEY=                          # fal.ai（海外）
# COMFYUI_URL=http://127.0.0.1:8188 # 本地 ComfyUI（可选装）
GEN_DEFAULT_BACKEND=auto
GEN_TIMEOUT=120
GEN_MAX_IMAGES=4

# ── VISION 图→prompt 后端（image2prompt 反向闭环）──
# 未配任何真实 Key 时自动降级 mock（不报错，meta.fallback_from 记录来源）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=                  # 兼容代理（Azure / OpenRouter）
# VISION_MODEL_OPENAI=gpt-4o
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# VISION_MODEL_CLAUDE=claude-sonnet-4-6
VISION_DEFAULT_BACKEND=auto
VISION_MAX_TOKENS=300

# ── 抠图模型 ──────────────────────────────────────────
# 默认 ~/.u2net；容器内 serve.py 自动指向 /app/models
# U2NET_HOME=/app/models

# ── 目录 ──────────────────────────────────────────────
COLORFLOW_UPLOAD_DIR=/tmp/colorflow-uploads
COLORFLOW_OUTPUT_DIR=/tmp/colorflow-output
